# Локальная разработка (docker-compose.local.yml): основная БД на хосте 5437
LOCAL_PGHOST=localhost
LOCAL_PGPORT=5437
LOCAL_DATABASE_URL=postgresql+asyncpg://app:appsecret@localhost:5437/rsd_db
LOCAL_TEST_DATABASE_URL=postgresql+asyncpg://app:appsecret@localhost:5433/rsd_test_db

# === Общие настройки ===
ENVIRONMENT=development
LOG_LEVEL=INFO

# === База данных ===
DB_HOST=db
DB_PORT=5432
DB_USER=app
DB_PASSWORD=appsecret
DB_NAME=rsd_db

# Полный URL базы данных (опционально, генерируется из DB_* если не задан)
# DATABASE_URL=postgresql+asyncpg://app:appsecret@db:5432/rsd_db

# === Реплика основной БД для чтения из микросервисов ===
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=replicatorsecret
MAIN_REPLICA_READONLY_USER=report_reader
MAIN_REPLICA_READONLY_PASSWORD=reportreadersecret
# MAIN_REPLICA_DATABASE_URL=postgresql+asyncpg://report_reader:reportreadersecret@db_replica:5432/rsd_db

# === БД микросервиса отчетов ===
REPORT_DB_SUPERUSER=report_admin
REPORT_DB_SUPERUSER_PASSWORD=reportadminsecret
REPORT_DB_NAME=rsd_reports
REPORT_DB_APP_USER=report_service
REPORT_DB_APP_PASSWORD=reportsecret
# REPORT_SERVICE_DATABASE_URL=postgresql+asyncpg://report_service:reportsecret@report_db:5432/rsd_reports

# === Тюнинг Postgres основной БД ===
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_WORK_MEM=16MB
POSTGRES_MAINTENANCE_WORK_MEM=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=2GB
POSTGRES_WAL_KEEP_SIZE=1024MB
POSTGRES_MAX_WAL_SENDERS=10
POSTGRES_MAX_REPLICATION_SLOTS=10
POSTGRES_CHECKPOINT_TIMEOUT=10min
POSTGRES_LOG_MIN_DURATION_STATEMENT=500ms

# === Тюнинг Postgres реплики ===
REPLICA_POSTGRES_MAX_CONNECTIONS=100
REPLICA_POSTGRES_SHARED_BUFFERS=256MB
REPLICA_POSTGRES_WORK_MEM=8MB
REPLICA_POSTGRES_MAINTENANCE_WORK_MEM=128MB
REPLICA_POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
REPLICA_POSTGRES_LOG_MIN_DURATION_STATEMENT=500ms

# === Тюнинг Postgres БД микросервиса отчетов ===
REPORT_POSTGRES_MAX_CONNECTIONS=50
REPORT_POSTGRES_SHARED_BUFFERS=256MB
REPORT_POSTGRES_WORK_MEM=8MB
REPORT_POSTGRES_MAINTENANCE_WORK_MEM=128MB
REPORT_POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
REPORT_POSTGRES_CHECKPOINT_TIMEOUT=10min
REPORT_POSTGRES_LOG_MIN_DURATION_STATEMENT=500ms

# === Kafka ===
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DB=0

# === Безопасность ===
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
REPORT_SERVICE_JWT_SECRET=change-report-service-secret
REPORT_SERVICE_JWT_ALGORITHM=HS256
REPORT_SERVICE_JWT_ISSUER=rsd-backend
REPORT_SERVICE_JWT_AUDIENCE=rsd-report-service
REPORT_SERVICE_JWT_EXPIRE_SECONDS=300
CORS_ORIGINS=https://app.example.com,http://localhost:5173

# === Nginx / Домены / TLS ===
FRONTEND_DOMAIN=app.example.com
API_DOMAIN=api.example.com
SSL_CERT_PATH=/etc/nginx/certs/live/app.example.com/fullchain.pem
SSL_CERT_KEY_PATH=/etc/nginx/certs/live/app.example.com/privkey.pem
