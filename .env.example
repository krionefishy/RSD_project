# === Общие настройки ===
ENVIRONMENT=development
LOG_LEVEL=INFO

# === База данных ===
DB_HOST=db
DB_PORT=5432
DB_USER=app
DB_PASSWORD=appsecret
DB_NAME=rsd_db

# Полный URL базы данных (опционально, генерируется из DB_* если не задан)
# DATABASE_URL=postgresql+asyncpg://app:appsecret@db:5432/rsd_db

# === Kafka ===
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DB=0

# === Безопасность ===
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
CORS_ORIGINS=https://app.example.com,http://localhost:5173

# === Nginx / Домены / TLS ===
FRONTEND_DOMAIN=app.example.com
API_DOMAIN=api.example.com
SSL_CERT_PATH=/etc/nginx/certs/live/app.example.com/fullchain.pem
SSL_CERT_KEY_PATH=/etc/nginx/certs/live/app.example.com/privkey.pem
