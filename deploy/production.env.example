# === Domains for Nginx ===
FRONTEND_DOMAIN=rsd.sdobin.ru
API_DOMAIN=rsd.sdobin.ru
SSL_CERT_PATH=/etc/nginx/certs/live/rsd.sdobin.ru/fullchain.pem
SSL_CERT_KEY_PATH=/etc/nginx/certs/live/rsd.sdobin.ru/privkey.pem

# === Database ===
DB_HOST=db
DB_PORT=5432
DB_USER=app
DB_PASSWORD=change-me-strong-password
DB_NAME=rsd_db

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password

# === Kafka ===
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# === Security ===
JWT_SECRET=change-me-minimum-32-characters-secret-key
JWT_ALGORITHM=HS256
CORS_ORIGINS=https://rsd.sdobin.ru

# === Environment ===
ENVIRONMENT=production
LOG_LEVEL=INFO
