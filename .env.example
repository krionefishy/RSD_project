# Пример конфигурации окружения для RSD проекта
# Скопируйте в .env и настройте под свое окружение

# === Общие настройки ===
ENVIRONMENT=development
LOG_LEVEL=INFO

# === База данных ===
DB_HOST=db
DB_PORT=5432
DB_USER=app
DB_PASSWORD=appsecret
DB_NAME=rsd_db

# Полный URL базы данных (опционально, генерируется из DB_* если не задан)
# DATABASE_URL=postgresql+asyncpg://app:appsecret@db:5432/rsd_db

# === Kafka ===
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# === Безопасность ===
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256

# === Traefik / Домены ===
ACME_EMAIL=your-email@example.com
FRONTEND_DOMAIN=app.example.com
API_DOMAIN=api.example.com

# === Сервисы ===
GATEWAY_URL=http://gateway:8000
AUTH_SERVICE_URL=http://auth_service:8001
KNOWLEDGE_BASE_SERVICE_URL=http://knowledge_base_service:8002
