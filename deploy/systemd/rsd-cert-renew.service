[Unit]
Description=Renew RSD Let's Encrypt certificates
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/rsd
ExecStart=/usr/bin/docker run --rm --volume /opt/rsd/deploy/certbot/www:/var/www/certbot --volume /opt/rsd/deploy/certbot/conf:/etc/letsencrypt certbot/certbot renew --webroot --webroot-path /var/www/certbot --quiet
ExecStartPost=/usr/bin/docker exec rsd-gateway-nginx nginx -s reload
